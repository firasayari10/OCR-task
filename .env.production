# Production Environment Configuration

# ============================================
# Model Hosting URLs
# ============================================

# Azure Blob Storage (recommended)
SAM2_BLOB_URL=https://your-storage.blob.core.windows.net/models/sam2_hiera_large.pt?sp=r&st=2024-01-01&se=2026-12-31&sv=2022-11-02&sr=b&sig=YOUR_SAS_TOKEN

# Or AWS S3
# SAM2_S3_URL=https://my-ocr-models.s3.amazonaws.com/sam2_hiera_large.pt

# Or HuggingFace Hub
SAM2_HF_REPO=firasayari10/sam2-medical-ocr

# ============================================
# Model Cache Directory
# ============================================
MODEL_CACHE_DIR=./model_cache
TRANSFORMERS_CACHE=./model_cache/huggingface
HF_HOME=./model_cache/huggingface

# ============================================
# Model Selection (for production)
# ============================================
USE_SAM2=true
USE_TROCR=false  # Disable heavy model if not needed
USE_VECTOR_DB=true

# ============================================
# API Keys
# ============================================
AZURE_VISION_KEY=your_azure_vision_key
AZURE_VISION_ENDPOINT=https://your-region.cognitiveservices.azure.com/
HUGGINGFACE_TOKEN=your_hf_token  # For private models

# ============================================
# Database
# ============================================
VECTOR_DB_PATH=./medication_db

# ============================================
# Production Settings
# ============================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
